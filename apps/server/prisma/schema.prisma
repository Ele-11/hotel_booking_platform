generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")  //  这个需要我们本地配置好 在 .env.example 中
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  username     String         @unique
  password     String
  fullName     String
  phone        String?
  avatar       String?
  role         UserRole       @default(CUSTOMER)
  status       UserStatus     @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  bookings     Booking[]
  hotels       Hotel[]        @relation("HotelOwner")
  merchantInfo Merchant?
  refreshToken RefreshToken[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([deletedAt])
}

model Merchant {
  id              String    @id @default(uuid())
  userId          String    @unique
  companyName     String
  businessLicense String?
  taxId           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  user            User      @relation(fields: [userId], references: [id])
}

model Hotel {
  id                String             @id @default(uuid())
  name              String
  englishName       String
  description       String
  starRating        Int
  address           String
  city              String
  country           String
  contactPhone      String
  contactEmail      String
  checkInTime       String             @default("14:00")
  checkOutTime      String             @default("12:00")
  amenities         String[]
  tags              String[]
  images            String[]
  status            HotelStatus        @default(PENDING)
  ownerId           String
  openingDate       DateTime           @default(now())
  discountInfo      String?
  nearbyShopping    String?
  nearbyTransport   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  auditReason       String?
  approvedBy        String?
  bookings          Booking[]
  owner             User               @relation("HotelOwner", fields: [ownerId], references: [id])
  nearbyAttractions NearbyAttraction[]
  roomTypes         RoomType[]
  minPrice          Int?
  maxPrice          Int?

  @@index([ownerId])
  @@index([city])
  @@index([starRating])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model RoomType {
  id            String      @id @default(uuid())
  hotelId       String
  name          String
  description   String?
  capacity      Int
  bedType       String
  area          Float?
  amenities     String[]
  images        String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  availableFrom DateTime?
  availableTo   DateTime?
  bookings      Booking[]
  pricePlans    PricePlan[]
  hotel         Hotel       @relation(fields: [hotelId], references: [id])

  @@index([hotelId])
  @@index([deletedAt])
}

model Booking {
  id                 String         @id @default(uuid())
  userId             String
  hotelId            String
  roomTypeId         String
  checkInDate        DateTime
  checkOutDate       DateTime
  guests             Int
  totalPrice         Int
  currency           String         @default("CNY")
  specialRequests    String?
  status             BookingStatus  @default(PENDING)
  paymentStatus      PaymentStatus  @default(PENDING)
  paymentMethod      PaymentMethod?
  paymentId          String?
  cancellationReason String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?
  hotel              Hotel          @relation(fields: [hotelId], references: [id])
  roomType           RoomType       @relation(fields: [roomTypeId], references: [id])
  user               User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([hotelId])
  @@index([roomTypeId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deletedAt])
}

model PricePlan {
  id         String    @id @default(uuid())
  roomTypeId String
  price      Int
  currency   String    @default("CNY")
  discount   Float?
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  roomType   RoomType  @relation(fields: [roomTypeId], references: [id])

  @@index([roomTypeId])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([deletedAt])
}

model NearbyAttraction {
  id          String         @id @default(uuid())
  hotelId     String
  name        String
  type        AttractionType
  distance    Int
  description String?
  images      String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  hotel       Hotel          @relation(fields: [hotelId], references: [id])

  @@index([hotelId])
  @@index([type])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Banner {
  id         String    @id @default(cuid())
  title      String
  imageUrl   String
  targetUrl  String?
  position   Int
  isActive   Boolean   @default(true)
  startDate  DateTime?
  endDate    DateTime?
  clickCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

enum UserRole {
  ADMIN
  MERCHANT
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum MerchantStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum HotelStatus {
  PENDING
  PUBLISHED
  REJECTED
  UNPUBLISHED
  SUSPENDED
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
  PARTIAL_REFUND
}

enum PaymentMethod {
  CREDIT_CARD
  ALIPAY
  WECHAT_PAY
  CASH
}

enum AttractionType {
  SCENIC_SPOT
  RESTAURANT
  SHOPPING
  TRANSPORTATION
  ENTERTAINMENT
  OTHER
}
